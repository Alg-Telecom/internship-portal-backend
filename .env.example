# Copy this file to .env and fill in real values. Never commit .env.
# In production (NODE_ENV=production) the server refuses to start if a
# secret below is missing or weak — see src/config/checkEnv.js.

NODE_ENV=development
PORT=5000

# Address of the frontend: used for CORS and in password-reset links.
FRONTEND_URL=http://localhost:5173

# Optional extra addresses allowed to call the API (comma-separated), e.g.
# the built site served on your Wi-Fi IP to test from a phone:
#   EXTRA_CORS_ORIGINS=http://192.168.1.20:3000
EXTRA_CORS_ORIGINS=

# Set to 1 when the API runs behind ONE reverse proxy (nginx, Render,
# Railway...), so rate limiting sees each visitor's real IP. Leave empty locally.
TRUST_PROXY=

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=internship_portal
DB_PORT=3306
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/internship_portal"

# Session tokens. Use a long random value, different in every environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_value
JWT_EXPIRES_IN=7d

# Outgoing email (SMTP). While testing, use a Mailtrap *sandbox* inbox so
# no email reaches real people. MAIL_FROM is also shown to users as the
# administration's contact address.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USER=your_smtp_user
MAILTRAP_PASS=your_smtp_password
MAIL_FROM="Internship Portal <no-reply@example.com>"
